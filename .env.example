# Footnote secrets-only environment template.
# Non-secret runtime settings live in footnote.yaml.

##############################################################################
# Core secrets
##############################################################################
INCIDENT_PSEUDONYMIZATION_SECRET=
TRACE_API_TOKEN=
REFLECT_SERVICE_TOKEN=
AGENT_API_TOKEN=

##############################################################################
# Inference providers
##############################################################################
OPENAI_API_KEY=
OPENAI_SAFETY_IDENTIFIER_SECRET=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=

##############################################################################
# Discord bot secrets (only needed when discord-bots are enabled in footnote.yaml)
##############################################################################
DISCORD_TOKEN=
BOT_PROFILE_PROMPT_OVERLAY=

##############################################################################
# Web/security integrations
##############################################################################
TURNSTILE_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=
OIDC_CLIENT_SECRET=

##############################################################################
# Storage/backup
##############################################################################
LITESTREAM_REPLICA_URL=

##############################################################################
# Alerts and observability
##############################################################################
INCIDENT_ALERTS_DISCORD_BOT_TOKEN=
INCIDENT_ALERTS_EMAIL_SMTP_PASSWORD=
VOLTAGENT_SECRET_KEY=
LANGFUSE_METADATA_MIRROR_PUBLIC_KEY=
LANGFUSE_METADATA_MIRROR_SECRET_KEY=

##############################################################################
# Optional search/context provider secrets
##############################################################################
CHAT_CONTEXT_WEB_SEARCH_BRAVE_API_KEY=
CHAT_CONTEXT_WEB_SEARCH_SERPAPI_API_KEY=
# GitHub context runtime controls: CHAT_CONTEXT_GITHUB_ENABLED,
# CHAT_CONTEXT_GITHUB_TIMEOUT_MS, CHAT_CONTEXT_GITHUB_MAX_RECORDS_PER_SECTION,
# CHAT_CONTEXT_GITHUB_PRIVATE_REPOSITORY_ALLOWLIST, CHAT_CONTEXT_GITHUB_CACHE_TTL_MS,
# and CHAT_CONTEXT_GITHUB_STALE_RESULT_LIMIT_MS. Defaults and descriptions live in config-spec.
CHAT_CONTEXT_GITHUB_TOKEN=
CHAT_CONTEXT_REVERSE_IMAGE_SEARCH_SERPAPI_API_KEY=

##############################################################################
# Optional image hosting secrets
##############################################################################
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

##############################################################################
# Optional trustgraph adapter secrets
##############################################################################
EXECUTION_CONTRACT_TRUSTGRAPH_ADAPTER_API_TOKEN=
EXECUTION_CONTRACT_TRUSTGRAPH_OWNERSHIP_API_TOKEN=

