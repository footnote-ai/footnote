{
    "name": "footnote",
    "private": true,
    "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
    "scripts": {
        "start": "node scripts/start.cjs",
        "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:web\"",
        "dev:backend:run": "pnpm exec tsx packages/backend/src/server.ts",
        "dev:backend": "pnpm backend:prepare && pnpm dev:backend:run",
        "dev:web:run": "pnpm --filter @footnote/web exec vite",
        "dev:web": "pnpm dev:web:run",
        "dev:bot": "pnpm --filter @footnote/discord-bot dev",
        "start:dev": "pnpm dev",
        "start:backend": "node scripts/preflight-dev-ports.cjs backend && cross-env NODE_OPTIONS= VSCODE_INSPECTOR_OPTIONS= pnpm dev:backend",
        "start:web": "node scripts/preflight-dev-ports.cjs web && cross-env NODE_OPTIONS= VSCODE_INSPECTOR_OPTIONS= pnpm dev:web",
        "start:bot": "node scripts/preflight-dev-ports.cjs bot && cross-env NODE_OPTIONS= VSCODE_INSPECTOR_OPTIONS= pnpm dev:bot",
        "start:all": "node scripts/start-all.cjs",
        "setup": "node scripts/setup.cjs",
        "settings": "node scripts/settings.cjs",
        "reset": "node scripts/reset.cjs",
        "settings:init": "node scripts/generate-footnote-settings.cjs",
        "settings:check": "node scripts/check-footnote-settings.cjs",
        "workspace:bootstrap": "node scripts/workspace-bootstrap.cjs",
        "workspace:dev": "pnpm workspace:bootstrap && pnpm start:all",
        "start:prod-test": "pnpm backend:prepare && pnpm --filter @footnote/backend build && cross-env NODE_ENV=production node server.js",
        "dev:prod-test": "concurrently \"pnpm backend:prepare && pnpm --filter @footnote/backend build && cross-env NODE_ENV=production node server.js\" \"pnpm --filter @footnote/web dev\"",
        "build:contracts": "pnpm --filter @footnote/contracts build",
        "build:prompts": "pnpm --filter @footnote/prompts build",
        "build:config-spec": "pnpm --filter @footnote/config-spec build",
        "build:api-client": "pnpm --filter @footnote/api-client build",
        "build:agent-runtime": "pnpm --filter @footnote/agent-runtime build",
        "build:launcher-core": "pnpm --filter @footnote/launcher-core build",
        "build:launcher-cli": "pnpm --filter @footnote/launcher-cli build",
        "build:backend": "pnpm --filter @footnote/backend build",
        "build:discord-bot": "pnpm --filter @footnote/discord-bot build",
        "build:web": "pnpm --filter @footnote/web build",
        "build": "pnpm build:contracts && pnpm build:prompts && pnpm build:config-spec && pnpm build:api-client && pnpm build:agent-runtime && pnpm build:launcher-core && pnpm build:launcher-cli && pnpm build:backend && pnpm build:discord-bot && pnpm build:web",
        "generate-annotation-schema": "pnpm exec tsx scripts/generate-annotation-schema.ts",
        "generate-landing-scenarios": "pnpm exec tsx scripts/generate-landing-scenarios.ts",
        "context:repo:list": "pnpm exec tsx scripts/list-repository-context.ts",
        "trustgraph:snapshot:validate": "pnpm exec tsx --test scripts/trustgraph-repo-snapshot.test.ts",
        "trustgraph:snapshot:load": "pnpm exec tsx scripts/load-trustgraph-repo-snapshot.ts",
        "check-annotation-schema": "pnpm exec tsx scripts/check-annotation-schema.ts",
        "validate-footnote-tags": "pnpm exec tsx scripts/validate-footnote-tags.ts",
        "validate-env": "pnpm exec tsx scripts/validate-env.ts",
        "validate-env-example-parity": "pnpm exec tsx scripts/validate-env-example-parity.ts",
        "validate-openapi-links": "pnpm exec tsx scripts/validate-openapi-links.ts",
        "test:build": "node scripts/test-build.cjs",
        "context:bundle": "node scripts/prepare-project-context-bundle.mjs",
        "refactor:lookup": "node scripts/refactor-lookup.cjs",
        "review": "node scripts/review.cjs",
        "sea:build-launcher": "node tools/sea/build-launcher.mjs",
        "sea:package": "node tools/sea/package-sea.mjs",
        "sea:checksums": "node tools/sea/checksums.mjs",
        "sea:verify": "node tools/sea/verify.mjs",
        "test:annotation-governance": "pnpm exec tsx --test scripts/annotation-schema.test.ts scripts/validate-footnote-tags.test.ts scripts/review.test.ts",
        "test:landing-scenarios": "pnpm exec tsx --test packages/web/src/data/landingScenarios.test.ts scripts/landing-scenario-generation.test.ts",
        "test:trustgraph-snapshot": "pnpm exec tsx --test scripts/trustgraph-repo-snapshot.test.ts",
        "test:refactor-lookup": "pnpm exec tsx --test scripts/refactor-lookup.test.ts",
        "test:repository-context": "pnpm exec tsx --test scripts/repository-context-files.test.ts",
        "type-check": "pnpm exec tsc --noEmit",
        "format:check": "node scripts/format-changed.cjs --check",
        "format:write": "node scripts/format-changed.cjs --write",
        "lint": "pnpm run format:check && pnpm run lint-check",
        "lint:fix": "pnpm run format:write && pnpm exec eslint packages/ --fix",
        "lint-check": "pnpm exec eslint packages/",
        "backend:prepare": "pnpm --filter @footnote/config-spec run build:dev && pnpm --filter @footnote/prompts run build:dev",
        "test:output": "pnpm exec playwright install chromium && pnpm exec playwright test && cross-env DISCORD_TOKEN=output-check-token DISCORD_CLIENT_ID=output-check-client DISCORD_USER_ID=output-check-user DISCORD_GUILD_IDS=output-check-guild INCIDENT_PSEUDONYMIZATION_SECRET=output-check-secret pnpm exec tsx --test packages/discord-bot/test/chatCommand.test.ts"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@playwright/test": "^1.61.0",
        "@swc/core": "catalog:",
        "@swc/helpers": "catalog:",
        "@types/better-sqlite3": "catalog:",
        "@types/js-yaml": "catalog:",
        "@types/mime-types": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/ws": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "concurrently": "catalog:",
        "cross-env": "catalog:",
        "csstype": "catalog:",
        "dependency-cruiser": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "globby": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "dotenv": "catalog:",
        "jsonwebtoken": "catalog:"
    }
}
