{
    "name": "@footnote/web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b tsconfig.json && vite build && pnpm run build:wiki",
        "build:wiki": "node wiki/scripts/stage-content.mjs && astro build --root wiki && node wiki/scripts/publish-dist.mjs",
        "preview": "vite preview",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@footnote/api-client": "workspace:*",
        "@footnote/contracts": "workspace:*",
        "@marsidev/react-turnstile": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-markdown": "catalog:",
        "react-router-dom": "catalog:",
        "remark-gfm": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@astrojs/markdown-remark": "catalog:",
        "@astrojs/starlight": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "astro": "catalog:",
        "autoprefixer": "catalog:",
        "esbuild": "catalog:",
        "postcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    }
}
