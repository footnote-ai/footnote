{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "baseUrl": ".",
        "paths": {
            "@footnote/config-spec": ["../config-spec/src/index.ts"],
            "@footnote/config-spec/*": ["../config-spec/src/*"]
        },
        "types": ["node"],
        "noEmitOnError": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"],
    "references": [{ "path": "../config-spec" }]
}
